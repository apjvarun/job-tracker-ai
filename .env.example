# AI APIs
ANTHROPIC_API_KEY=sk-ant-...          # Claude API (fallback for matching + cover letters)
GOOGLE_API_KEY=AIzaSy...              # Gemini API (primary for matching + cover letters)

# Google OAuth (required for dashboard auth)
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# Flask session encryption (must be stable across workers/restarts)
FLASK_SECRET_KEY=<run: python3 -c "import secrets; print(secrets.token_hex(32))">

# Telegram notifications
TELEGRAM_BOT_TOKEN=...               # Create via @BotFather on Telegram
TELEGRAM_CHAT_ID=...                 # Your chat ID

# Email notifications (Gmail SMTP — requires 2FA + App Password)
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=...               # Create at myaccount.google.com/apppasswords

# Dashboard access control (comma-separated email allowlist)
ALLOWED_EMAILS=you@gmail.com,other@gmail.com

# Email recipient for job alerts
NOTIFICATION_EMAIL=you@gmail.com
